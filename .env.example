# Example environment variables for contract-management-api
# Copy this file to .env and fill with real values before running

# Database
DB_URL=jdbc:mysql://localhost:3306/contract_management?useSSL=false&serverTimezone=UTC
DB_USERNAME=app_user
DB_PASSWORD=change_me

# Mail (Gmail SMTP)
MAIL_USERNAME=you@example.com
MAIL_APP_PASSWORD=change_me

# Server (optional - values also set in application.yaml)
SERVER_PORT=8081
SERVER_ADDRESS=0.0.0.0
SERVER_SERVLET_CONTEXT_PATH=/api

# Logging
LOGGING_LEVEL_COM_CONTRACT_MANAGEMENT=DEBUG
